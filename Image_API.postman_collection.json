{
  "info": {
    "_postman_id": "6c1b469a-7534-4732-920f-6fa1ccca2a83",
    "name": "Standalone Image API",
    "description": "Collection for the Django image-processing API. Upload accepts JPEG, PNG, or WebP and generates fixed WebP variants.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "asset_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/healthz",
          "host": ["{{base_url}}"],
          "path": ["healthz"]
        }
      },
      "response": []
    },
    {
      "name": "Images",
      "item": [
        {
          "name": "Upload image and create variants",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Response is 201 Created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('asset_id', body.id);",
                  "pm.test('Asset is ready with five presets', function () {",
                  "  pm.expect(body.status).to.eql('ready');",
                  "  pm.expect(body.presets).to.have.members(['thumb', 'small', 'medium', 'large', 'xlarge']);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "",
                  "description": "Choose a JPEG, PNG, or WebP file in Postman before sending. Do not set Content-Type manually; Postman adds the multipart boundary."
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/images",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "images"]
            },
            "description": "Creates one original file plus thumb, small, medium, large, and xlarge WebP variants. A successful response stores its id in the collection variable {{asset_id}}."
          },
          "response": []
        },
        {
          "name": "Get asset metadata",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/images/{{asset_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "images", "{{asset_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Get medium WebP variant",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/images/{{asset_id}}/medium",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "images", "{{asset_id}}", "medium"]
            },
            "description": "Change medium to thumb, small, large, or xlarge to retrieve another fixed preset."
          },
          "response": []
        },
        {
          "name": "Get original uploaded image",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/images/{{asset_id}}/original",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "images", "{{asset_id}}", "original"]
            },
            "description": "Returns the validated original file in its uploaded format, such as image/png."
          },
          "response": []
        },
        {
          "name": "Delete asset",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Response is 204 No Content', function () {",
                  "  pm.response.to.have.status(204);",
                  "});",
                  "pm.collectionVariables.unset('asset_id');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/images/{{asset_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "images", "{{asset_id}}"]
            },
            "description": "Permanently deletes the original, all generated variants, and the database record."
          },
          "response": []
        }
      ]
    }
  ]
}
