# Copy this file to .env and replace values for the target environment.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=images-api.example.com
DATABASE_URL=postgresql://image_api:replace-with-url-encoded-password@127.0.0.1:5432/image_api

# Set persistent absolute paths in production when needed.
# MEDIA_ROOT=/srv/image-api/media
# IMAGE_STORAGE_ROOT=/srv/image-api/media/images

MAX_FILE_SIZE=104857600
MAX_WIDTH=16000
MAX_HEIGHT=16000
MAX_PIXELS=120000000
